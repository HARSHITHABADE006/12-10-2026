# =============================================================================
#  Appointment & Service Booking System - Environment configuration
# =============================================================================
#  HOW TO USE
#  -----------
#  1. Copy this file to `.env`:
#         Copy-Item .env.example .env
#  2. Replace every placeholder value below with a real value.
#  3. NEVER commit `.env` to Git. It is listed in `.gitignore`.
#  4. `.env.example` IS committed and must never contain real secrets.
#
#  Generate a Django SECRET_KEY with:
#         python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CORE DJANGO
# -----------------------------------------------------------------------------

# Development / staging / production.
# In production this MUST be "production" so that DEBUG-only behaviour is off.
DJANGO_SETTINGS_ENVIRONMENT=development

# Cryptographically random. Used to sign sessions, tokens and password resets.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-50-character-random-string

# Comma-separated list. Use localhost + 127.0.0.1 during development.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Master switch for debug mode. Never set to True in production.
DEBUG=True

# Store every datetime in UTC in the database.
# Display times are converted to each provider's own IANA time zone.
TIME_ZONE=UTC
USE_TZ=True
USE_I18N=True
LANGUAGE_CODE=en-us


# -----------------------------------------------------------------------------
# 2. DATABASE (MySQL 8.0)
# -----------------------------------------------------------------------------
# The database and user must already exist. Create them once with:
#     CREATE DATABASE appointment_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE USER 'appointment_user'@'localhost' IDENTIFIED BY '<strong-password>';
#     GRANT ALL PRIVILEGES ON appointment_db.* TO 'appointment_user'@'localhost';
#     FLUSH PRIVILEGES;

DB_ENGINE=django.db.backends.mysql
DB_NAME=appointment_db
DB_USER=appointment_user
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Seconds. Raise this to 20+ in production so slow queries fail fast instead
# of piling up while row locks are held.
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# Set to True only when the database server does not enforce the STRICT_TRANS_TABLES
# sql_mode. STRICT mode is strongly recommended (see docs/PHASE01.md).
DB_STRICT_MODE=True

# Test database used by pytest-django and the Django test runner.
# The test user needs CREATE/DROP DATABASE privileges.
TEST_DB_NAME=test_appointment_db


# -----------------------------------------------------------------------------
# 3. FRONTEND / CORS
# -----------------------------------------------------------------------------

# Origins allowed to call the API from a browser. Exact origins, no trailing slash.
# Requests WITHOUT an Origin header (curl, Postman, server-to-server) are
# unaffected by CORS, so you can still test with Postman.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CORS_ALLOW_CREDENTIALS=True

# Django admin (server-rendered HTML) must never be reachable from a cross-origin
# browser context. These headers are added by SecurityMiddleware.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# -----------------------------------------------------------------------------
# 4. AUTHENTICATION (JWT via djangorestframework-simplejwt)
# -----------------------------------------------------------------------------

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

AUTH_PASSWORD_VALIDATORS_CLASSES=
    django.contrib.auth.password_validation.UserAttributeSimilarityValidator,
    django.contrib.auth.password_validation.MinimumLengthValidator,
    django.contrib.auth.password_validation.CommonPasswordValidator,
    django.contrib.auth.password_validation.NumericPasswordValidator

# Argon2 is the preferred hasher. Options: argon2, pbkdf2_sha256, bcrypt.
# Only hashes NEW passwords; existing ones keep working until they change.
PASSWORD_HASHERS_ARGON2=argon2-cffi
PASSWORD_HASHERS_ARGON2_MEMORY_MB=65536
PASSWORD_HASHERS_ARGON2_TIME_COST=3
PASSWORD_HASHERS_ARGON2_PARALLELISM=4
PASSWORD_HASHERS_ARGON2_HASH_LEN=16
PASSWORD_HASHERS_ARGON2_SALT_LEN=16


# -----------------------------------------------------------------------------
# 5. EMAIL
# -----------------------------------------------------------------------------
# development -> prints emails to the console (EMAIL_BACKEND=console).
# production  -> sends real emails through the SMTP server below.

# Options: console, smtp, locmem (locmem is used by the test suite)
EMAIL_BACKEND=console
DEFAULT_FROM_EMAIL=no-reply@appointments.example.com

# Used by the frontend to build absolute links in emails.
FRONTEND_BASE_URL=http://localhost:5173

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10


# -----------------------------------------------------------------------------
# 6. CACHES (rate limiting + Celery result backend in development)
# -----------------------------------------------------------------------------
# In production swap REDIS_CACHE_URL for a real Redis instance and always
# terminate with redis:// rather than rediss:// unless TLS is configured.

REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1


# -----------------------------------------------------------------------------
# 7. FILE UPLOADS (provider profile images)
# -----------------------------------------------------------------------------

MAX_UPLOAD_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp


# -----------------------------------------------------------------------------
# 8. API SCHEMA (drf-spectacular)
# -----------------------------------------------------------------------------

# Set to False in production so /api/docs/ and /api/schema/ are not public.
SPECTACULAR_ENABLED=True

# Staff accounts can still reach the docs in production via
#   /api/schema/swagger-ui/?staff=1  (log in to /admin/ first)
SPECTACULAR_SWAGGER_UI_SETTINGS=persistAuthorization,filter,displayRequestDuration


# -----------------------------------------------------------------------------
# 9. PRODUCTION SECURITY HARDENING
# -----------------------------------------------------------------------------
# These only take effect when DJANGO_SETTINGS_ENVIRONMENT=production.

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
SECURE_PROXY_SSL_HEADER=
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=False
SESSION_COOKIE_AGE=1209600
SESSION_COOKIE_NAME=appointments_sessionid


# -----------------------------------------------------------------------------
# 10. BUSINESS RULES
# -----------------------------------------------------------------------------

# Minimum lead time (hours) before an appointment a customer may book.
BOOKING_MIN_LEAD_TIME_HOURS=2

# How far ahead (days) availability can be queried or booked.
BOOKING_MAX_ADVANCE_DAYS=90

# Minimum notice (hours) a customer must give to cancel on their own.
CANCELLATION_MIN_NOTICE_HOURS=12

# How long a PENDING appointment blocks its slot before expiring (hours).
PENDING_APPOINTMENT_HOLD_HOURS=2

# Slot grid step in minutes. MUST be >= the shortest service duration.
BOOKING_SLOT_INTERVAL_MINUTES=15

# Reminder timing for upcoming appointments.
REMINDER_HOURS_BEFORE_APPOINTMENT=24

# Demo guard rails - remove or raise once features are built.
FREE_EMAIL_DOMAINS=
SIGNUP_REQUIRES_ADMIN_APPROVAL=True
STAFF_CAN_SIGNUP=False
PUBLIC_SIGNUP_VERIFICATION=False